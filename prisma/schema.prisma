// Agency OS — Prisma schema
//
// Development runs on SQLite. The schema is deliberately kept
// Postgres-compatible so the only change needed at deploy time is the
// datasource block below (provider = "postgresql").
//
// Postgres-compatibility rules observed throughout:
//   - String IDs generated with cuid() (no autoincrement / serial).
//   - Enums are modelled as String + a documented union of allowed values,
//     because SQLite has no native enum. Constants live in lib/constants.ts,
//     which is the single source of truth for both DB writes and UI.
//   - No SQLite-only column types, no Json columns, no array columns.
//   - Every timestamp is DateTime, stored UTC, formatted for Asia/Karachi in
//     the UI via lib/date.ts. Date-only fields (startDate, endDate, dueDate)
//     are stored at UTC midnight of the intended calendar day.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person who can sign in. ADMIN is the agency owner; MEMBER is a
/// delivery team member (designer, marketer, developer).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// "ADMIN" | "MEMBER" — see Role in lib/constants.ts
  role         String   @default("MEMBER")
  /// Delivery specialism, e.g. "Shopify Developer", "Media Buyer".
  jobTitle     String
  /// E.164, e.g. "+923001234567". Only used for the optional WhatsApp channel;
  /// with WHATSAPP_* unset it is never read.
  phone        String?
  /// Hex colour used for the member's avatar chip, from AVATAR_COLORS.
  avatarColor  String   @default("#1A6B3A")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  milestones    Milestone[]        @relation("MilestoneAssignee")
  scoreEvents   ScoreEvent[]       @relation("ScoreEventSubject")
  authoredScore ScoreEvent[]       @relation("ScoreEventAuthor")
  reports       Report[]
  notifications Notification[]
  comments      Comment[]
  mentions      CommentMention[]
  attachments   Attachment[]
  activity      Activity[]         @relation("ActivityActor")
  attendance    AttendanceDay[]
  leaveRequests LeaveRequest[]     @relation("LeaveSubject")
  leaveReviews  LeaveRequest[]     @relation("LeaveReviewer")
  outages       OutageReport[]     @relation("OutageSubject")
  outageReviews OutageReport[]     @relation("OutageReviewer")
  breaks        BreakSession[]
  pushSubs      PushSubscription[]
  blocksRaised  BlockPeriod[]      @relation("BlockAuthor")
  blocksCleared BlockPeriod[]      @relation("BlockReleaser")

  @@index([role])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Phase 2 — Clients, engagements, modules and milestones
// ---------------------------------------------------------------------------

/// An e-commerce business on a monthly retainer.
model Client {
  id            String   @id @default(cuid())
  businessName  String
  contactName   String
  email         String
  phone         String?
  country       String?
  industry      String?
  /// Whole currency units (USD). Integer, never Float — money is not binary.
  monthlyBudget Int      @default(0)
  /// "LEAD" | "ACTIVE" | "PAUSED" | "CHURNED" — see CLIENT_STATUSES.
  status        String   @default("LEAD")
  notes         String?
  onboardedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
  reports  Report[]

  @@index([status])
  @@index([businessName])
}

/// The agency's offerings. Seeded, and editable by the owner.
model ServiceCatalog {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Stable key used to look up the built-in planning template. Renaming a
  /// service in the UI must not orphan its template, so the slug never changes.
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  projects ProjectService[]
  modules  Module[]

  @@index([isActive])
}

/// One engagement cycle for one client — normally a calendar month.
model Project {
  id          String    @id @default(cuid())
  clientId    String
  title       String
  startDate   DateTime
  endDate     DateTime
  /// "PLANNING" | "ACTIVE" | "COMPLETED" | "OVERDUE_CLOSEOUT"
  status      String    @default("PLANNING")
  /// Set by the evaluation job when the cycle is closed out, so close-out
  /// runs exactly once per project.
  closedOutAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services ProjectService[]
  modules  Module[]

  @@index([clientId])
  @@index([status])
  @@index([endDate])
}

/// Which services a given engagement cycle covers. A join model rather than
/// an array column, so this ports to Postgres unchanged.
model ProjectService {
  projectId String
  serviceId String

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

/// A workstream inside a project, e.g. "Google Ads" or "Weekly Reporting".
model Module {
  id        String   @id @default(cuid())
  projectId String
  name      String
  serviceId String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service    ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  milestones Milestone[]

  @@index([projectId])
}

/// A dated deliverable owned by one team member. The unit the scoring engine
/// reacts to.
model Milestone {
  id                 String    @id @default(cuid())
  moduleId           String
  title              String
  description        String?
  /// 1–5. Drives every scoring deduction in lib/scoring.ts.
  weight             Int       @default(3)
  /// Date-only, stored at UTC midnight. The effective deadline is the end of
  /// that day in Asia/Karachi — see dueDeadline() in lib/date.ts.
  dueDate            DateTime
  /// "PENDING" | "IN_PROGRESS" | "BLOCKED" | "SUBMITTED" | "COMPLETED" | "MISSED"
  status             String    @default("PENDING")
  /// When the member handed the work in. Phase 8: this — not completedAt — is
  /// what LATE and EARLY_BONUS are judged against, so the owner's review speed
  /// can never move a member's score. Cleared on rejection and stamped again
  /// on resubmission, so lateness always reflects the latest submission.
  submittedAt        DateTime?
  /// Set when an ADMIN approves. No longer feeds member scoring; it marks the
  /// work signed off and closes the review clock.
  completedAt        DateTime?
  /// Minutes from submission to the owner's decision on it. The owner's
  /// metric, not the member's, and shown only to the owner.
  adminReviewMinutes Int?

  // --- Blocked clock (Phase 8) ---------------------------------------------
  /// "CLIENT" | "INTERNAL_DEPENDENCY" | "EXTERNAL" while blocked, else null.
  blockedReason       String?
  blockedNote         String?
  /// The milestone this one is waiting on; completing it auto-unblocks.
  blockingMilestoneId String?
  /// Start of the block currently running, null when not blocked.
  blockedSince        DateTime?
  /// Total minutes spent blocked. The sum of this milestone's BlockPeriod
  /// rows, cached here because scoring reads it on every evaluation.
  blockedMinutes      Int       @default(0)
  /// Status to return to when the block clears.
  statusBeforeBlock   String?

  assigneeId String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("MilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  scoreEvents ScoreEvent[]
  comments    Comment[]
  attachments Attachment[]
  activity    Activity[]
  blocks      BlockPeriod[]

  blockingMilestone Milestone?  @relation("MilestoneBlocker", fields: [blockingMilestoneId], references: [id], onDelete: SetNull)
  blockedDependents Milestone[] @relation("MilestoneBlocker")

  @@index([moduleId])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([status])
  @@index([blockingMilestoneId])
  @@index([status, submittedAt])
}

/// One period a milestone spent blocked.
///
/// The milestone carries a running total for scoring, but this is the record:
/// it is what attributes delay to a client rather than to the member, and it
/// survives the milestone being blocked and released repeatedly for different
/// reasons.
model BlockPeriod {
  id                  String    @id @default(cuid())
  milestoneId         String
  /// "CLIENT" | "INTERNAL_DEPENDENCY" | "EXTERNAL"
  reason              String
  note                String
  blockingMilestoneId String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  /// Filled when the period ends; null while it is still running.
  minutes             Int?
  createdById         String
  releasedById        String?
  /// True when the owner judged the block illegitimate. A vetoed period is
  /// kept but contributes no time to the effective deadline.
  vetoed              Boolean   @default(false)
  vetoNote            String?

  milestone  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("BlockAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  releasedBy User?     @relation("BlockReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([reason, startedAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Performance scoring
// ---------------------------------------------------------------------------

/// An immutable ledger entry. A member's monthly score is always derived as
/// 100 + sum(events for that month), clamped 0–100 — there is deliberately no
/// mutable score column anywhere in this schema.
model ScoreEvent {
  id          String   @id @default(cuid())
  userId      String
  milestoneId String?
  /// "LATE" | "MISSED" | "REJECTED" | "EARLY_BONUS" | "MANUAL_ADJUST"
  type        String
  /// Signed. Always a multiple of 0.5, which is exactly representable in
  /// binary floating point, so sums never drift.
  points      Float
  /// Required for every event; MANUAL_ADJUST refuses to save without one.
  reason      String
  /// Calendar month of the cycle this event scores against, in Asia/Karachi.
  year        Int
  month       Int
  /// Present for automatic events ("<milestoneId>:LATE") and null for the
  /// repeatable ones (REJECTED, MANUAL_ADJUST). The unique index is what makes
  /// re-running the evaluation job idempotent. Multiple NULLs are permitted by
  /// both SQLite and Postgres.
  dedupeKey   String?  @unique
  /// The admin behind a rejection or manual adjustment.
  createdById String?
  createdAt   DateTime @default(now())

  user      User       @relation("ScoreEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("ScoreEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId, year, month])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — Automated reporting and notifications
// ---------------------------------------------------------------------------

/// A generated report.
///
/// The `payload` is a frozen snapshot taken at generation time. A report is a
/// statement about a period that has closed, so it must never change when the
/// underlying data does — reopening a milestone months later cannot be allowed
/// to rewrite what August's report said.
model Report {
  id          String   @id @default(cuid())
  /// "MEMBER_WEEKLY" | "MEMBER_MONTHLY" | "CLIENT_WEEKLY"
  type        String
  periodStart DateTime
  periodEnd   DateTime
  /// Set for member reports.
  userId      String?
  /// Set for client reports.
  clientId    String?
  generatedAt DateTime @default(now())
  /// Serialized JSON. Stored as text rather than a Json column: SQLite has no
  /// native Json type, and keeping this portable is the standing rule here.
  /// lib/reports.ts owns the parse and the version field inside it.
  payload     String
  /// "<type>:<periodStart>:<subjectId>". A unique index on it is what makes
  /// regeneration idempotent — the same period cannot produce two reports.
  dedupeKey   String   @unique

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([type, periodStart])
  @@index([userId, type])
  @@index([clientId, type])
}

// ---------------------------------------------------------------------------
// Phase 5 — Collaboration on a milestone
// ---------------------------------------------------------------------------

/// A comment on a milestone. One level of threading: a reply points at the
/// comment it answers, and replies of replies are flattened into the same
/// thread — deep nesting turns a work discussion into a maze.
model Comment {
  id          String   @id @default(cuid())
  milestoneId String
  userId      String
  body        String
  /// Null for a top-level comment; otherwise the comment being replied to.
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestone Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?         @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]        @relation("CommentThread")
  mentions  CommentMention[]

  @@index([milestoneId, createdAt])
  @@index([parentId])
}

/// Who a comment mentioned. Stored rather than re-parsed, so renaming someone
/// can never silently change who was notified about what.
model CommentMention {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

/// An uploaded file.
///
/// `storedName` is server-generated and is the only thing ever used to build a
/// path; `filename` is the untrusted original, kept for display only.
model Attachment {
  id          String   @id @default(cuid())
  milestoneId String
  uploaderId  String
  /// Original name, shown to people. Never used for filesystem access.
  filename    String
  /// Generated name on disk, e.g. "<cuid>.png".
  storedName  String   @unique
  mimeType    String
  /// Bytes.
  size        Int
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([milestoneId, createdAt])
}

/// The audit trail: what happened, to what, and who did it.
///
/// Written by the routes that change things rather than by database triggers,
/// so each entry can carry a sentence a person can actually read.
model Activity {
  id          String   @id @default(cuid())
  /// "STATUS_CHANGED" | "REASSIGNED" | "DUE_DATE_CHANGED" | "SCORE_EVENT"
  /// | "COMMENT_ADDED" | "ATTACHMENT_ADDED" | "MILESTONE_CREATED"
  type        String
  /// Pre-rendered, e.g. "moved Campaign launch to Submitted".
  summary     String
  /// Optional extra detail — a rejection reason, the old and new date.
  detail      String?
  milestoneId String?
  /// Null for anything the system did on its own (the evaluation pass).
  actorId     String?
  createdAt   DateTime @default(now())

  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor     User?      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([milestoneId, createdAt])
}

/// An in-app notification. No email yet — that's a later phase.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// "TASK_ASSIGNED" | "DUE_TOMORROW" | "OVERDUE" | "WORK_APPROVED"
  /// | "WORK_REJECTED" | "REPORT_READY"
  type      String
  title     String
  body      String
  /// Where clicking it should take them.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  milestoneId String?
  reportId    String?

  /// Present for the ones a repeated job could otherwise duplicate
  /// (due-tomorrow, overdue, report-ready); null for one-off events.
  dedupeKey String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 7 — Attendance
// ---------------------------------------------------------------------------

/// One person's working day.
///
/// `date` is the Asia/Karachi calendar date stored at UTC midnight, the same
/// convention as every other date-only field here. All attendance arithmetic
/// resolves to Karachi wall-clock regardless of where the member's device is.
model AttendanceDay {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime
  clockInAt    DateTime?
  clockOutAt   DateTime?
  /// "PRESENT" | "LATE" | "ABSENT" | "LEAVE" | "OFF"
  status       String    @default("PRESENT")
  /// Minutes between clock-in and clock-out, once the day is closed.
  totalMinutes Int?
  /// True when the evaluation job closed the day because nobody clocked out.
  autoClosed   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks AvailabilityCheck[]

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
}

/// A hidden, randomly scheduled proof-of-availability.
///
/// `scheduledAt` is the secret. It is generated server-side at clock-in and
/// must never reach a member's browser before it triggers — see
/// lib/attendance-visibility.ts, which is the single place that decides what a
/// member is allowed to see.
model AvailabilityCheck {
  id              String    @id @default(cuid())
  attendanceDayId String
  scheduledAt     DateTime
  /// scheduledAt + the configured window (60 minutes by default).
  windowEndsAt    DateTime
  respondedAt     DateTime?
  /// "SCHEDULED" | "ACTIVE" | "PASSED" | "MISSED" | "CANCELLED"
  /// | "PENDING_REVIEW" (an outage report covers it) | "EXCUSED" (upheld)
  status          String    @default("SCHEDULED")
  /// The outage report that put this check under review.
  outageReportId  String?
  /// How many times a break pushed this check later in the day. Kept so the
  /// owner can see a member whose breaks keep landing on their checks.
  deferrals       Int       @default(0)
  createdAt       DateTime  @default(now())

  day    AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  outage OutageReport? @relation(fields: [outageReportId], references: [id], onDelete: SetNull)

  @@index([attendanceDayId])
  @@index([status, scheduledAt])
  @@index([status, windowEndsAt])
  @@index([outageReportId])
}

/// A member declaring time they were unreachable through no fault of theirs.
///
/// Load-shedding and dropped links are facts of remote work in Karachi, so a
/// missed check that overlaps a declared outage does not charge automatically —
/// it waits for the owner's judgement.
model OutageReport {
  id           String    @id @default(cuid())
  userId       String
  /// "POWER" | "INTERNET"
  type         String
  startsAt     DateTime
  endsAt       DateTime
  note         String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status       String    @default("PENDING")
  /// True when the report was filed after a covered check had already expired.
  /// Not a judgement — an outage stops you filing too — but the owner sees it.
  filedLate    Boolean   @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime  @default(now())

  user       User                @relation("OutageSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("OutageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  checks     AvailabilityCheck[]

  @@index([userId, startsAt])
  @@index([status, createdAt])
}

/// Protected time inside the shift: prayer, a meal, or a short personal break.
///
/// Never penalized within the daily allowance. While one is open no check
/// activates and none can expire, so a break can never cost points.
model BreakSession {
  id         String    @id @default(cuid())
  userId     String
  /// Karachi day at UTC midnight, so a day's allowance is one query.
  date       DateTime
  /// "PRAYER" | "MEAL" | "PERSONAL"
  reason     String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  minutes    Int?
  /// True when the daily job closed a break the member left running.
  autoClosed Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, endedAt])
}

/// A browser push endpoint. One row per device, so a member on a phone and a
/// laptop is reached on both.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A member's request to be off on a given day.
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime
  reason       String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  user       User  @relation("LeaveSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One request per person per day — a second would make "is this day
  /// approved?" ambiguous.
  @@unique([userId, date])
  @@index([status, date])
}

/// Agency-wide configuration, editable by the owner without a deploy.
///
/// A single row rather than a key/value table: these settings are a fixed,
/// known set, and typed columns mean a bad value fails at the database rather
/// than at whatever code parses the string.
model Settings {
  /// Always "singleton".
  id String @id @default("singleton")

  /// Minutes past Karachi midnight.
  shiftStartMinutes   Int @default(720) // 12:00
  shiftEndMinutes     Int @default(1320) // 22:00
  clockInOpensMinutes Int @default(690) // 11:30
  /// Clock-in later than shiftStart + grace counts as LATE.
  graceMinutes        Int @default(15)
  /// No clock-in by this time and no approved leave means ABSENT.
  absentCutoffMinutes Int @default(900) // 15:00

  checksPerDay               Int @default(3)
  checkWindowMinutes         Int @default(60)
  /// Earliest a check may fall, measured from clock-in.
  checkEarliestOffsetMinutes Int @default(45)
  /// Latest a check may be scheduled, so its window still ends by shift end.
  checkLatestMinutes         Int @default(1260) // 21:00
  checkMinGapMinutes         Int @default(90)

  /// Penalties, stored positive and applied as deductions.
  penaltyLateClockIn Float @default(0.5)
  penaltyAbsentDay   Float @default(3)
  penaltyMissedCheck Float @default(1)

  /// Working days as ISO weekday numbers, 1 = Monday. Sunday (7) is off.
  workdays String @default("1,2,3,4,5,6")

  // --- Fairness settings (Phase 8) -----------------------------------------
  /// Protected prayer/meal/personal minutes per day. Never penalized.
  breakAllowanceMinutes Int @default(90)
  /// How many outage reports a member may file per calendar month.
  outageReportsPerMonth Int @default(4)
  /// Longest single outage a member may declare, in hours.
  outageMaxHours        Int @default(4)
  /// Hours the owner has to review submitted work before it is flagged.
  reviewSlaHours        Int @default(48)

  updatedAt DateTime @updatedAt
}
