{
  "name": "bwm-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-db-provider.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-db-provider.mjs && prisma generate",
    "build": "next build",
    "vercel-build": "node scripts/sync-db-provider.mjs && prisma generate && PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" prisma db push && DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" tsx prisma/seed.ts && next build",
    "start": "next start",
    "share": "node scripts/share.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:provider": "node scripts/sync-db-provider.mjs",
    "db:push": "node scripts/sync-db-provider.mjs && prisma db push",
    "db:migrate": "node scripts/sync-db-provider.mjs && prisma migrate dev",
    "db:deploy": "node scripts/sync-db-provider.mjs && prisma migrate deploy",
    "db:seed": "node scripts/sync-db-provider.mjs && tsx prisma/seed.ts",
    "db:seed:admin": "node scripts/sync-db-provider.mjs && tsx prisma/seed-admin.ts",
    "promote": "node scripts/sync-db-provider.mjs && node scripts/promote-admin.mjs",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/sync-db-provider.mjs && prisma db push --force-reset && npm run db:seed",
    "smoke": "node scripts/sync-db-provider.mjs && node --import tsx scripts/smoke.mjs",
    "smoke:empty": "node scripts/sync-db-provider.mjs && node --import tsx scripts/smoke.mjs --empty",
    "smoke:browser": "node --import tsx scripts/smoke-browser.mjs",
    "leaks": "node scripts/sync-db-provider.mjs && node --import tsx scripts/leak-scan.mjs",
    "permtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/permtest.mjs",
    "fieldtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/fieldtest.mjs",
    "journeytest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/journeytest.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "14.2.33",
    "next-auth": "4.24.11",
    "nodemailer": "^6.9.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.4",
    "web-push": "^3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
